# Copy this file to .env and enter your PostgreSQL connection string.
# For local development, use your database provider's EXTERNAL connection URL.
# Never commit .env or share its password.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
PORT=3000
NODE_ENV=development
# Optional: comma-separated frontend origins. Leave blank to allow all origins.
CLIENT_ORIGINS=
# Set this to your deployed API URL after deploying, for example:
PUBLIC_BASE_URL=https://your-service-name.onrender.com
STUDENT_NUMBER=REPLACE_WITH_YOUR_STUDENT_NUMBER
